{
  // Production/background build config (service worker + supporting services).
  // Excludes only spec test files; test helpers remain available for type-aware linting.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist/background",
    "types": ["chrome-types", "jasmine"]
  },
  "include": [
    "src/background/**/*.ts",
    "src/types/**/*.d.ts"
  ],
  "exclude": [
    "src/background/__tests__/**/*.bg-spec.ts"
  ]
}
