{
  "name": "chrome-tabs-rotator",
  "version": "1.6.0",
  "scripts": {
    "start": "ng build --watch --configuration development",
    "build": "ng build && node scripts/zip.js",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.background.json --noEmit && tsc -p tsconfig.harness.json --noEmit && tsc -p tsconfig.tools.json --noEmit",
    "test:bg:build": "tsc -p tsconfig.background.spec.json",
    "test:bg": "yarn run test:bg:build && jasmine --config=jasmine.background.json",
    "test:bg:watch": "concurrently \"tsc -p tsconfig.background.spec.json --watch --preserveWatchOutput\" \"jasmine --config=jasmine.background.json --watch\"",
    "test:ui": "ng test --watch=false --browsers=ChromeHeadless || ng test --watch=false",
    "test:ui:watch": "ng test",
    "test:all": "yarn test:bg && yarn test:ui",
    "test:all:watch": "concurrently \"yarn test:bg:watch\" \"ng test\"",
    "test": "yarn test:all",
    "test:bg:coverage": "yarn test:bg:build && nyc --reporter=lcov --reporter=text-summary node scripts/run-bg-specs.cjs",
    "test:ui:coverage": "cross-env KARMA_BROWSERS=ChromeHeadlessCI ng test --watch=false --code-coverage --browsers=ChromeHeadlessCI",
    "test:coverage": "yarn test:bg:coverage && yarn test:ui:coverage",
    "lint:css": "stylelint \"src/**/*.{css,scss}\"",
    "lint:ts": "eslint \"src/**/*.ts\"",
    "lint:ts:strict": "eslint --max-warnings=0 \"src/**/*.ts\"",
    "lint:ts:fix": "eslint --fix \"src/**/*.ts\"",
    "tailwind:generate": "node scripts/build-tailwind.mjs",
    "e2e:build": "ng build",
    "e2e": "yarn e2e:build && playwright test",
    "e2e:headed": "yarn e2e:build && playwright test --headed",
    "e2e:debug": "yarn e2e:build && PWDEBUG=1 playwright test --headed",
    "e2e:install-browsers": "npx playwright install chromium",
    "quality": "yarn typecheck && yarn lint:ts:strict && yarn lint:css"
  },
  "private": true,
  "engines": {
    "node": ">=20.19.0 <21 || >=22.12.0 <23 || >=24.0.0",
    "npm": ">=10",
    "yarn": "1.x"
  },
  "packageManager": "yarn@1.22.22",
  "dependencies": {
    "@angular/animations": "20.3.5",
    "@angular/common": "20.3.5",
    "@angular/compiler": "20.3.5",
    "@angular/core": "20.3.5",
    "@angular/forms": "20.3.5",
    "@angular/platform-browser": "20.3.5",
    "@angular/platform-browser-dynamic": "20.3.5",
    "@angular/router": "20.3.5",
    "@fortawesome/angular-fontawesome": "3.0.0",
    "@fortawesome/free-solid-svg-icons": "7.1.0",
    "@tailwindcss/postcss": "4.1.14",
    "file-saver": "2.0.5",
    "lodash": "4.17.21",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "zone.js": "0.15.1"
  },
  "devDependencies": {
    "@angular-builders/custom-webpack": "20.0.0",
    "@angular/build": "20.3.6",
    "@angular/cli": "20.3.6",
    "@angular/compiler-cli": "20.3.5",
    "@tailwindcss/forms": "0.5.10",
    "@types/file-saver": "2.0.7",
    "@types/jasmine": "5.1.10",
    "@types/lodash": "4.17.20",
    "@types/node": "24.7.2",
    "@playwright/test": "1.56.0",
    "archiver": "7.0.1",
    "chrome-types": "0.1.383",
    "concurrently": "9.2.1",
    "cross-env": "10.1.0",
    "jasmine": "5.12.0",
    "jasmine-core": "5.12.0",
    "karma": "6.4.4",
    "karma-chrome-launcher": "3.2.0",
    "karma-coverage": "2.2.1",
    "karma-jasmine": "5.1.0",
    "karma-jasmine-html-reporter": "2.1.0",
    "nyc": "17.1.0",
    "postcss": "8.5.6",
    "source-map-support": "0.5.21",
    "tailwindcss": "4.1.14",
    "ts-node": "10.9.2",
    "typescript": "5.9.3",
    "webpack-ext-reloader": "1.1.13",
    "xbytes": "1.9.1",
    "stylelint": "16.25.0",
    "stylelint-config-standard": "39.0.1",
    "stylelint-config-recommended": "17.0.0",
    "eslint": "9.37.0",
    "@typescript-eslint/parser": "8.46.1",
    "@typescript-eslint/eslint-plugin": "8.46.1",
    "@angular-eslint/eslint-plugin": "20.4.0",
    "@angular-eslint/eslint-plugin-template": "20.4.0",
    "@angular-eslint/template-parser": "20.4.0"
  }
}
