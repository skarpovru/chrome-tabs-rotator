{
  // Playwright E2E tests build config (CommonJS for Node execution environment).
  // Includes test utilities + specs under e2e/ only.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "types": ["node", "@playwright/test"],
    "moduleResolution": "Node",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "outDir": "dist/e2e"
  },
  "include": ["e2e/**/*.ts"],
  "exclude": ["node_modules"]
}
