{
  "extension": [".ts", ".js"],
  "include": [
    "out-tsc/background-spec/background/**/*.js",
    "src/background/**/*.ts"
  ],
  "exclude": [
    "src/background/__tests__/**",
    "**/*.bg-spec.ts"
  ],
  "reporter": ["text-summary", "lcov"],
  "all": true,
  "excludeAfterRemap": false,
  "check-coverage": true,
  "statements": 40,
  "branches": 30,
  "functions": 40,
  "lines": 40
}
