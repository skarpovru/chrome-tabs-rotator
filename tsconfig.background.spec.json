{
  "extends": "./tsconfig.background.json",
  "compilerOptions": {
    "outDir": "./out-tsc/background-spec",
    "module": "CommonJS",
    // Override base/moduleResolution for CommonJS runtime so extensionless relative imports work.
    "moduleResolution": "node",
    "types": ["chrome-types", "jasmine", "node"],
    "target": "ES2022"
  },
  "include": [
    "src/background/**/*.ts",
    "src/background/__tests__/**/*.bg-spec.ts",
    "src/types/**/*.d.ts"
  ]
}
