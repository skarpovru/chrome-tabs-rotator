{
  "extends": [
    "stylelint-config-recommended",
    "stylelint-config-standard"
  ],
  "rules": {
    "at-rule-no-unknown": [
      true,
      {
        "ignoreAtRules": [
          "tailwind",
          "theme",
          "plugin",
          "source",
          "utility"
        ]
      }
    ],
    "no-empty-source": null,
    "block-no-empty": true
  }
}
